{
  "name": "dsh-usage-card",
  "version": "0.11.3-ui",
  "description": "Sidebar card for DeepSeek Harness: per-session cost, token buckets, and context share by source.",
  "keywords": ["dsh", "deepseek-harness", "plugin", "usage", "cost", "token"],
  "license": "MIT",
  "author": "Icstick",
  "repository": { "type": "git", "url": "git+https://github.com/Icstick/dsh-usage-card.git" },
  "homepage": "https://github.com/Icstick/dsh-usage-card#readme",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "default": "./src/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "src",
    "lib",
    "client",
    "scripts",
    "test",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-alpha.0 <1.0.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-alpha.0 <1.0.0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node test/m0-check.mjs && node test/wiring-check.mjs && node test/subagent-check.mjs && node test/report-check.mjs && node test/prices-check.mjs && node test/isolation-check.mjs",
    "verify": "node scripts/verify.mjs"
  }
}
